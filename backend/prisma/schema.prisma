generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  label     String
  keyHash   String   @unique
  createdAt DateTime @default(now())
  submissions Submission[]
  scheduled   Scheduled[]
  communities Community[]
}

model Community {
  userId    String
  name      String
  rulesHash String
  approved  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, name])
}

model Submission {
  id           String   @id @default(cuid())
  userId       String
  fingerprint  String
  title        String
  subreddit    String
  state        String
  redditUrl    String?
  error        String?
  score        Int?
  replyEnabled Boolean  @default(false)
  replyTemplate String?
  clicks       Int      @default(0)
  leads        Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, fingerprint])
}

model Scheduled {
  id          String   @id @default(cuid())
  userId      String
  title       String
  kind        String
  text        String   @default("")
  url         String   @default("")
  scheduledAt DateTime
  state       String   @default("pending")
  result      String?
  error       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
